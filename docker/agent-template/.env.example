# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# Local model server (the Mac mini). Use its Tailscale IP:
# MagicDNS names may not resolve inside containers.
OLLAMA_BASE_URL=http://100.x.y.z:11434

# Uptime Kuma push monitor. The agent calls this after each successful run,
# so you get an alert when it goes quiet.
UPTIME_KUMA_PUSH_URL=http://<uptime-kuma-host>:3001/api/push/<token>

# API key for a hosted model, if the agent uses one
LLM_API_KEY=
